{
  "name": "pokadrovo-web",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "npm run test:admin && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "preview:chat": "node tools/build-chat-preview.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "node server/app.mjs",
    "admin:setup": "node server/setup.mjs",
    "test:admin": "node --test server/tests/*.test.mjs",
    "test:accounts": "node --test server/tests/accounts.test.mjs",
    "test:browser-models": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@fontsource/outfit": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "motion": "14.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
