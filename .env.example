# Copy to .env when preparing your own host. No secrets go here.
# Full domain, without https://, path or port.
POKADROVO_DOMAIN=
# Email and password registration; guests may still edit locally.
POKADROVO_ACCOUNTS_ENABLED=1
POKADROVO_GUEST_EDITING=1
# Social sign-in is disabled at the server, including provider callbacks.
POKADROVO_SOCIAL_LOGIN_ENABLED=0
